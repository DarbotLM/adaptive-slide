{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-slide.dev/schemas/tile.schema.json",
  "title": "Adaptive Tile",
  "description": "Base schema for an Adaptive Tile — the atomic content unit within a slide's Adaptive Card bucket. Each tile type extends this base with its own card schema.",
  "type": "object",
  "required": ["type"],
  "discriminator": {
    "propertyName": "type"
  },
  "oneOf": [
    { "$ref": "tiles/text-tile.schema.json" },
    { "$ref": "tiles/image-tile.schema.json" },
    { "$ref": "tiles/code-tile.schema.json" },
    { "$ref": "tiles/chart-tile.schema.json" },
    { "$ref": "tiles/media-tile.schema.json" },
    { "$ref": "tiles/container-tile.schema.json" },
    { "$ref": "tiles/input-text-tile.schema.json" },
    { "$ref": "tiles/input-number-tile.schema.json" },
    { "$ref": "tiles/input-choice-set-tile.schema.json" },
    { "$ref": "tiles/input-date-tile.schema.json" },
    { "$ref": "tiles/input-time-tile.schema.json" },
    { "$ref": "tiles/input-toggle-tile.schema.json" },
    { "$ref": "tiles/adaptive-element-tile.schema.json" },
    { "$ref": "tiles/adaptive-card-tile.schema.json" }
  ],
  "$defs": {
    "TileBase": {
      "type": "object",
      "description": "Common properties shared by all tile types",
      "properties": {
        "type": {
          "type": "string",
          "description": "Discriminator for the tile type"
        },
        "id": {
          "type": "string",
          "description": "Unique identifier for this tile within the slide"
        },
        "isVisible": {
          "type": "boolean",
          "default": true,
          "description": "Whether this tile is visible"
        },
        "spacing": {
          "type": "string",
          "enum": ["none", "small", "default", "medium", "large", "extraLarge", "padding"],
          "default": "default"
        },
        "separator": {
          "type": "boolean",
          "default": false,
          "description": "Draw a separator line above this tile"
        },
        "height": {
          "type": "string",
          "description": "Adaptive Cards element height behavior"
        },
        "requires": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Adaptive Cards feature requirements map"
        },
        "fallback": {
          "description": "Adaptive Cards fallback element or 'drop'",
          "oneOf": [
            { "const": "drop" },
            {
              "type": "object",
              "required": ["type"],
              "additionalProperties": true
            }
          ]
        },
        "gridPosition": {
          "$ref": "#/$defs/GridPosition",
          "description": "Position within a grid layout (only used when slide layout is 'grid')"
        },
        "freeformPosition": {
          "$ref": "#/$defs/FreeformPosition",
          "description": "Absolute position within a freeform layout"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["Tile.Image", "Tile.Photo"]
              }
            },
            "required": ["type"]
          },
          "else": {
            "properties": {
              "height": {
                "enum": ["auto", "stretch"]
              }
            }
          }
        }
      ],
      "required": ["type"]
    },
    "GridPosition": {
      "type": "object",
      "properties": {
        "column": { "type": "integer", "minimum": 1 },
        "row": { "type": "integer", "minimum": 1 },
        "columnSpan": { "type": "integer", "minimum": 1, "default": 1 },
        "rowSpan": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "additionalProperties": false
    },
    "FreeformPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "X position as percentage of the slide canvas (0-100)"
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Y position as percentage of the slide canvas (0-100)"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "Width as percentage of the slide canvas (greater than 0, up to 100)"
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "Height as percentage of the slide canvas (greater than 0, up to 100)"
        },
        "rotation": { "type": "number", "default": 0, "description": "Rotation in degrees" },
        "zIndex": { "type": "integer", "default": 0 }
      },
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-slide.dev/schemas/deck.schema.json",
  "title": "Adaptive Slide Deck",
  "description": "Root schema for an Adaptive Slide presentation deck. A deck is an ordered collection of slides with shared metadata and theming.",
  "type": "object",
  "required": ["$schema", "type", "version", "slides"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URI reference to this schema for validation"
    },
    "type": {
      "const": "AdaptiveDeck",
      "description": "Discriminator identifying this as a deck"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Semantic version of the deck format (e.g. '1.0.0')"
    },
    "metadata": {
      "$ref": "#/$defs/DeckMetadata"
    },
    "theme": {
      "$ref": "#/$defs/Theme"
    },
    "card": {
      "$ref": "#/$defs/AdaptiveCardOptions",
      "description": "Default native Adaptive Cards root properties applied to each transformed slide"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "slide.schema.json"
      },
      "description": "Ordered array of slides in the presentation"
    },
    "defaults": {
      "$ref": "#/$defs/SlideDefaults",
      "description": "Default settings inherited by all slides unless overridden"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["defaults"],
        "properties": {
          "defaults": {
            "type": "object",
            "required": ["layout"],
            "properties": {
              "layout": {
                "const": "freeform"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "slides": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "required": ["layout"]
                },
                {
                  "properties": {
                    "body": {
                      "type": "array",
                      "items": {
                        "required": ["freeformPosition"]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "DeckMetadata": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "modified": { "type": "string", "format": "date-time" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "language": {
          "type": "string",
          "description": "BCP 47 language tag (e.g. 'en-US')"
        }
      },
      "additionalProperties": true
    },
    "Theme": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accentColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "fontFamily": { "type": "string" },
        "darkMode": { "type": "boolean", "default": false }
      },
      "additionalProperties": true
    },
    "SlideDefaults": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "string",
          "enum": ["stack", "grid", "freeform"],
          "default": "stack"
        },
        "transition": {
          "type": "string",
          "enum": ["none", "fade", "slide-left", "slide-right", "slide-up", "zoom"],
          "default": "none"
        },
        "padding": {
          "type": "string",
          "enum": ["none", "small", "default", "large"],
          "default": "default"
        }
      },
      "additionalProperties": true
    },
    "AdaptiveCardOptions": {
      "type": "object",
      "description": "Native Adaptive Cards root properties from the bundled AC 1.6 schema, excluding type, $schema, body, and actions because Adaptive Slide owns those fields.",
      "properties": {
        "version": { "const": "1.6" },
        "refresh": {
          "type": "object",
          "additionalProperties": true
        },
        "authentication": {
          "type": "object",
          "additionalProperties": true
        },
        "selectAction": {
          "$ref": "#/$defs/AdaptiveSelectAction"
        },
        "fallbackText": { "type": "string" },
        "backgroundImage": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            {
              "type": "object",
              "required": ["url"],
              "additionalProperties": true,
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "fillMode": { "type": "string" },
                "horizontalAlignment": { "type": "string" },
                "verticalAlignment": { "type": "string" }
              }
            }
          ]
        },
        "minHeight": { "type": "string" },
        "rtl": { "type": "boolean" },
        "speak": { "type": "string" },
        "lang": { "type": "string" },
        "verticalContentAlignment": {
          "type": "string",
          "enum": ["top", "center", "bottom"]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "AdaptiveAction": {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Action.OpenUrl", "Action.Submit", "Action.Execute", "Action.ToggleVisibility", "Action.ShowCard"]
        },
        "title": { "type": "string" },
        "id": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "data": {},
        "verb": { "type": "string" },
        "targetElements": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["elementId"],
                "additionalProperties": true
              }
            ]
          }
        },
        "card": {
          "type": "object",
          "additionalProperties": true
        },
        "associatedInputs": {
          "type": "string",
          "enum": ["auto", "none"]
        },
        "style": { "type": "string" },
        "mode": { "type": "string" },
        "isEnabled": { "type": "boolean" },
        "iconUrl": { "type": "string" },
        "tooltip": { "type": "string" },
        "requires": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "fallback": {}
      },
      "additionalProperties": true
    },
    "AdaptiveSelectAction": {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Action.OpenUrl", "Action.Submit", "Action.Execute", "Action.ToggleVisibility"]
        },
        "title": { "type": "string" },
        "id": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "data": {},
        "verb": { "type": "string" },
        "targetElements": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["elementId"],
                "additionalProperties": true
              }
            ]
          }
        },
        "associatedInputs": {
          "type": "string",
          "enum": ["auto", "none"]
        },
        "style": { "type": "string" },
        "mode": { "type": "string" },
        "isEnabled": { "type": "boolean" },
        "iconUrl": { "type": "string" },
        "tooltip": { "type": "string" },
        "requires": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "fallback": {}
      },
      "additionalProperties": true
    }
  }
}

{
  "name": "adaptive-slide",
  "version": "0.2.1",
  "description": "A schema-driven presentation builder/viewer built on Adaptive Cards with MCP App support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "adaptive-slide-server": "./dist/plugins/mcp-app/server.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.js",
    "docs:build": "docusaurus build website --config docusaurus.config.cjs",
    "docs:deploy": "node scripts/deploy-docs.js",
    "docs:serve": "docusaurus serve website/build",
    "docs:start": "docusaurus start website --config docusaurus.config.cjs",
    "validate": "node scripts/validate.js",
    "test": "node --test tests/*.test.js",
    "lint": "tsc --noEmit",
    "serve": "node dist/plugins/mcp-app/server.js",
    "dev": "tsx src/plugins/mcp-app/server.ts",
    "postinstall": "patch-package"
  },
  "keywords": [
    "adaptive-cards",
    "presentation",
    "slides",
    "schema",
    "json-schema",
    "mcp",
    "mcp-app"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "gh-pages": "^6.3.0",
    "minimatch": "^10.2.5",
    "patch-package": "^8.0.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0-canary-fef12a01-20260413",
    "react-dom": "^19.3.0-canary-fef12a01-20260413",
    "serialize-javascript": "^7.0.7",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "uuid": "^14.0.1"
  }
}
